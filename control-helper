#!/usr/bin/python3
"""Privileged actions for Aurora Control (run through pkexec)."""
import os
import pwd
import re
import subprocess
import sys

GOVERNORS = {"ondemand", "performance", "powersave", "conservative", "schedutil"}
USER_RE = re.compile(r"[a-z][a-z0-9_-]{0,30}")


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def sh(*cmd):
    r = subprocess.run(list(cmd), capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if out:
        print(out[-600:])
    return r.returncode


def main():
    if os.geteuid() != 0:
        die("Must run as root.")
    try:
        caller = pwd.getpwuid(int(os.environ["PKEXEC_UID"]))
    except (KeyError, ValueError):
        die("Not permitted.")
    if caller.pw_uid < 1000 or caller.pw_name == "aurora-setup":
        die("Not permitted.")

    args = sys.argv[1:]
    act = args[0] if args else ""

    if act == "governor" and len(args) == 2 and args[1] in GOVERNORS:
        with open("/etc/aurora/cpu-governor", "w") as fh:
            fh.write(args[1] + "\n")
        sys.exit(sh("/usr/lib/aurora/set-governor"))

    elif act == "unattended" and len(args) == 2 and args[1] in ("on", "off"):
        v = "1" if args[1] == "on" else "0"
        with open("/etc/apt/apt.conf.d/20auto-upgrades", "w") as fh:
            fh.write('APT::Periodic::Update-Package-Lists "1";\n'
                     f'APT::Periodic::Unattended-Upgrade "{v}";\n'
                     'APT::Periodic::AutocleanInterval "7";\n')

    elif act == "cleanup":
        sh("apt-get", "clean")
        sh("apt-get", "-y", "autoremove", "--purge")
        sh("journalctl", "--vacuum-size=50M")
        sh("flatpak", "uninstall", "--unused", "-y", "--noninteractive")
        sh("sh", "-c", "rm -rf /var/lib/systemd/coredump/* /var/tmp/* 2>/dev/null; echo cleaned")

    elif act == "rename-user" and len(args) == 2:
        new = args[1]
        if not USER_RE.fullmatch(new):
            die("Invalid username.")
        try:
            pwd.getpwnam(new)
            die("That username already exists.")
        except KeyError:
            pass
        os.makedirs("/var/lib/aurora", exist_ok=True)
        with open("/var/lib/aurora/pending-rename", "w") as fh:
            fh.write(f"{caller.pw_name} {new}\n")
        print("Rename scheduled; it is applied on the next boot.")

    elif act == "recovery-reboot":
        sys.exit(sh("reboot", "0 tryboot"))

    else:
        die("Unknown or invalid action.")


if __name__ == "__main__":
    main()
