# pi-gen configuration for Aurora OS (Raspberry Pi 4, 64-bit, Debian trixie + Plasma)
IMG_NAME='Aurora'
RELEASE=trixie
TARGET_HOSTNAME=aurora

# Defaults only; the first-boot wizard sets the real language/timezone/keyboard.
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT='English (US)'
TIMEZONE_DEFAULT=Etc/UTC

ENABLE_SSH=0

# pi-gen insists on creating one "first user". We use it as a throw-away,
# password-locked setup account that the wizard deletes. build.sh appends a
# random FIRST_USER_PASS at build time; it is locked again inside the image.
FIRST_USER_NAME=aurora-setup
DISABLE_FIRST_BOOT_USER_RENAME=1

# Only run the base stages plus our own stage; skip pi-gen's stage3-5.
STAGE_LIST="stage0 stage1 stage2 stage-aurora"

DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
