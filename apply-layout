#!/bin/sh
# Apply the Aurora panel layout once per user, after plasmashell is up.
MARK="$HOME/.config/aurora/layout-applied"
[ -e "$MARK" ] && exit 0
i=0
while [ "$i" -lt 60 ]; do
    gdbus introspect --session --dest org.kde.plasmashell --object-path /PlasmaShell >/dev/null 2>&1 && break
    i=$((i + 1))
    sleep 1
done
sleep 3
if gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell \
    --method org.kde.PlasmaShell.evaluateScript "$(cat /usr/share/aurora/layout.js)" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$MARK")"
    touch "$MARK"
fi
